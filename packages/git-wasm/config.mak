CC = emcc
AR = emar
RANLIB = emranlib
uname_S = Linux
NO_CURL = 1
NO_OPENSSL = 1
NO_EXPAT = 1
NO_PERL = 1
NO_PYTHON = 1
NO_TCLTK = 1
NO_GETTEXT = 1
NO_ICONV = 1
NO_PTHREADS = 1
NO_REGEX = NeedsStartEnd
NO_UNIX_SOCKETS = 1
NO_MMAP = 1
NO_INSTALL_HARDLINKS = 1
NO_GITWEB = 1
NO_RUST = 1
SKIP_DASHED_BUILT_INS = 1
CSPRNG_METHOD = getentropy
HAVE_SYNC_FILE_RANGE =
HAVE_SYSINFO =
FSMONITOR_DAEMON_BACKEND =
FSMONITOR_OS_SETTINGS =
CFLAGS = -O2 -g0 -sUSE_ZLIB=1
X = .mjs
