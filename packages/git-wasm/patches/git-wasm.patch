+#ifdef __EMSCRIPTEN__
+/*
+ * There are no processes in the browser. A child that is a git command runs to completion in a new
+ * module instance (frc_spawn_sync, provided by the host), given its standard input as a buffer.
+ */
+extern int frc_spawn_sync(const char *argv, int argv_len, const char *env, int env_len, const char *dir,
+			  int in_fd, const char *in, int in_len, char **out, int *out_len, char **err, int *err_len);
+
+extern char **environ;
+
+static void frc_pack(struct strbuf *sb, const char *const *v)
+{
+	for (; v && *v; v++) {
+		strbuf_addstr(sb, *v);
+		strbuf_addch(sb, 0);
+	}
+}
+
+/* Defined in git.c */
+int is_builtin(const char *s);
+
+/*
+ * Only git and its builtins exist here. An unknown git-<command> would be run as git <command>, which
+ * looks for git-<command> again, for ever.
+ */
+static int frc_is_git(struct child_process *cmd)
+{
+	const char *name = cmd->args.v[0];
+
+	return cmd->git_cmd || (name && (!strcmp(name, "git") || (skip_prefix(name, "git-", &name) && is_builtin(name))));
+}
+
+static int frc_spawn(struct child_process *cmd, const char *in, size_t in_len,
+		     struct strbuf *out, struct strbuf *err)
+{
+	struct strbuf argv = STRBUF_INIT, env = STRBUF_INIT, input = STRBUF_INIT;
+	char *captured_out = NULL, *captured_err = NULL;
+	int out_len = 0, err_len = 0, in_fd = -1, code;
+
+	if (!frc_is_git(cmd)) {
+		errno = ENOENT;
+		if (!cmd->silent_exec_failure)
+			error_errno("cannot run %s", cmd->args.v[0]);
+		child_process_clear(cmd);
+		return -1;
+	}
+	if (cmd->git_cmd)
+		strbuf_addstr(&argv, "git") , strbuf_addch(&argv, 0);
+	frc_pack(&argv, cmd->args.v);
+	/* setenv() changes the C environment, which the host cannot see, so all of it is passed */
+	frc_pack(&env, (const char *const *) environ);
+	frc_pack(&env, cmd->env.v);
+
+	/* The child reads a descriptor's file from the file system they share, not from a copy */
+	if (in)
+		strbuf_add(&input, in, in_len);
+	else if (cmd->in > 0 && !cmd->no_stdin)
+		in_fd = cmd->in;
+
+	fflush(NULL);
+	trace_run_command(cmd);
+	code = frc_spawn_sync(argv.buf, argv.len, env.buf, env.len, cmd->dir, in_fd, input.buf, input.len,
+			      &captured_out, &out_len, &captured_err, &err_len);
+	if (cmd->in > 0)
+		close(cmd->in);
+
+	if (out)
+		strbuf_add(out, captured_out, out_len);
+	else if (!cmd->no_stdout)
+		write_in_full(cmd->out > 0 ? cmd->out : cmd->stdout_to_stderr ? 2 : 1, captured_out, out_len);
+	if (err)
+		strbuf_add(err, captured_err, err_len);
+	else if (!cmd->no_stderr)
+		write_in_full(cmd->err > 0 ? cmd->err : 2, captured_err, err_len);
+	if (cmd->out > 0)
+		close(cmd->out);
+	if (cmd->err > 0)
+		close(cmd->err);
+	free(captured_out);
+	free(captured_err);
+	strbuf_release(&argv);
+	strbuf_release(&env);
+	strbuf_release(&input);
+	child_process_clear(cmd);
+	invalidate_lstat_cache();
+	return code;
+}
+
+#define FRC_CHILDREN 16
+#define FRC_PID_BASE 100000
+static struct {
+	int used;
+	int code;
+	int pending;		/* the command runs when it is finished, after the parent has written its input */
+	int out_dup, err_dup;
+	char in_name[40];
+} frc_children[FRC_CHILDREN];
+
+int frc_tempfile(void)
+{
+	char name[] = "/tmp/frc-child-XXXXXX";
+	int fd = mkstemp(name);
+
+	if (fd < 0)
+		die_errno("cannot create a temporary file");
+	unlink(name);
+	return fd;
+}
+
+/* Provided by the host: a stand-in for a remote helper such as git-remote-https */
+extern void frc_helper_open(const char *name, const char *url);
+
+static int frc_start_helper(struct child_process *cmd, int slot)
+{
+	frc_helper_open(cmd->args.v[1], cmd->args.v[2]);
+	cmd->in = open("/dev/frc-helper-in", O_WRONLY);
+	cmd->out = open("/dev/frc-helper-out", O_RDONLY);
+	frc_children[slot].used = 1;
+	frc_children[slot].code = 0;
+	frc_children[slot].pending = 0;
+	cmd->pid = FRC_PID_BASE + slot;
+	return 0;
+}
+
+static int frc_start(struct child_process *cmd)
+{
+	int out_fd = -1, err_fd = -1, slot;
+	int need_in = !cmd->no_stdin && cmd->in < 0;
+	int need_out = !cmd->no_stdout && !cmd->stdout_to_stderr && cmd->out < 0;
+	int need_err = !cmd->no_stderr && cmd->err < 0;
+
+	for (slot = 0; slot < FRC_CHILDREN && frc_children[slot].used; slot++)
+		;
+	if (slot == FRC_CHILDREN)
+		BUG("too many children");
+	if (cmd->git_cmd && cmd->args.v[0] && starts_with(cmd->args.v[0], "remote-"))
+		return frc_start_helper(cmd, slot);
+
+	/* Output goes to unlinked files: a pipe cannot be read to its end without another process */
+	if (need_out) {
+		out_fd = frc_tempfile();
+		cmd->out = dup(out_fd);
+	}
+	if (need_err) {
+		err_fd = frc_tempfile();
+		cmd->err = dup(err_fd);
+	}
+	frc_children[slot].used = 1;
+	frc_children[slot].pending = need_in;
+	cmd->pid = FRC_PID_BASE + slot;
+	if (need_in) {
+		/* The parent writes the input, and the command runs from finish_command */
+		int fd;
+
+		xsnprintf(frc_children[slot].in_name, sizeof(frc_children[slot].in_name), "/tmp/frc-stdin-%d", slot);
+		fd = open(frc_children[slot].in_name, O_WRONLY | O_CREAT | O_TRUNC, 0600);
+		frc_children[slot].out_dup = cmd->out;
+		frc_children[slot].err_dup = cmd->err;
+		cmd->in = fd;
+		cmd->out = need_out ? out_fd : cmd->out;
+		cmd->err = need_err ? err_fd : cmd->err;
+		return 0;
+	}
+	frc_children[slot].code = frc_spawn(cmd, NULL, 0, NULL, NULL);
+	if (need_out) {
+		lseek(out_fd, 0, SEEK_SET);
+		cmd->out = out_fd;
+	}
+	if (need_err) {
+		lseek(err_fd, 0, SEEK_SET);
+		cmd->err = err_fd;
+	}
+	return 0;
+}
+
+/*
+ * Runs a child that is waiting for its input. The parent's descriptors for the output are rewound,
+ * so it can read what the child wrote.
+ */
+static void frc_run_input_child(struct child_process *cmd, int slot)
+{
+	int out_parent = cmd->out, err_parent = cmd->err;
+
+	cmd->in = open(frc_children[slot].in_name, O_RDONLY);
+	cmd->out = frc_children[slot].out_dup;
+	cmd->err = frc_children[slot].err_dup;
+	frc_children[slot].code = frc_spawn(cmd, NULL, 0, NULL, NULL);
+	frc_children[slot].pending = 0;
+	unlink(frc_children[slot].in_name);
+	cmd->in = -1;
+	cmd->out = out_parent;
+	cmd->err = err_parent;
+	if (out_parent > 0)
+		lseek(out_parent, 0, SEEK_SET);
+	if (err_parent > 0)
+		lseek(err_parent, 0, SEEK_SET);
+}
+
+/* For a parent that reads the output of a child before finish_command, after closing its input */
+void frc_run_pending(struct child_process *cmd)
+{
+	if (cmd->pid >= FRC_PID_BASE && frc_children[cmd->pid - FRC_PID_BASE].pending)
+		frc_run_input_child(cmd, cmd->pid - FRC_PID_BASE);
+}
+
+static int frc_finish(struct child_process *cmd)
+{
+	int slot = cmd->pid - FRC_PID_BASE;
+	int code;
+
+	if (frc_children[slot].pending)
+		frc_run_input_child(cmd, slot);
+	code = frc_children[slot].code;
+	frc_children[slot].used = 0;
+	cmd->pid = -1;
+	child_process_clear(cmd);
+	return code;
+}
