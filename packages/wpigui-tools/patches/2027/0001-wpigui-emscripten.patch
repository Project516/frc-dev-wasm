+  }
+  io.DisplaySize.x /= gFitScale;
+  io.DisplaySize.y /= gFitScale;
+  io.DisplayFramebufferScale.x *= gFitScale;
+  io.DisplayFramebufferScale.y *= gFitScale;
+}
