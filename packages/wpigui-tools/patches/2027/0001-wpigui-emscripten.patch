+  // Another page can share this thread, so an app can ask for fewer frames,
+  // and fewer still while nobody uses the app.
+  static double lastFrame = 0;
+  double now = emscripten_get_now();
+  double minMs = now - wpiguiLastInputMs() < 1000 ||
+                         wpiguiIdleFrameMs < wpiguiMinFrameMs
+                     ? wpiguiMinFrameMs
+                     : wpiguiIdleFrameMs;
+  if (now - lastFrame < minMs) {
+    return;
+  }
+  double framePeriod = lastFrame > 0 ? (now - lastFrame) / 1000.0
+                                     : 1.0 / FALLBACK_MOUSE_MOTION_WHEEL_FPS;
+  lastFrame = now;
+  MainLoopIteration(framePeriod);
+}
+#endif
