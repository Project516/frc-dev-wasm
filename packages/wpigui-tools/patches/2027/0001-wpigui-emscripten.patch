+static void FitDisplay() {
+  ImGuiIO& io = ImGui::GetIO();
+  gFitScale = 1;
+  if (gContext->loadedWidthHeight && gContext->width > 0 &&
+      gContext->height > 0) {
+    gFitScale = (std::max)(0.05f, (std::min)({1.0f, io.DisplaySize.x / gContext->width,
