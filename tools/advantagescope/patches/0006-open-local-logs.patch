+const localFiles = new Map<string, File>();
+
+/** Opens log files chosen or dropped by the user. */
+function openLocalFiles(files: File[]) {
+  if (files.length === 0) return;
+  files.forEach((file) => localFiles.set(file.name, file));
+  sendMessage(hubPort, "open-files", { files: files.map((file) => file.name), merge: false });
+}
+
+/** Shows a file picker for local logs. */
+function pickLocalFiles() {
+  const input = document.createElement("input");
+  input.type = "file";
+  input.multiple = true;
+  input.accept = ".wpilog,.rlog,.dslog,.dsevents,.csv,.log";
+  input.onchange = () => openLocalFiles(Array.from(input.files ?? []));
+  input.click();
+}
 
